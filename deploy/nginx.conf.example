# nginx TLS reverse proxy for the harness (alternative to Caddy).
# Obtain the cert with certbot, then point ssl_certificate at it.
#   certbot certonly --nginx -d appeals.example.com

server {
    listen 80;
    server_name appeals.example.com;
    return 301 https://$host$request_uri;   # force HTTPS
}

server {
    listen 443 ssl http2;
    server_name appeals.example.com;

    ssl_certificate     /etc/letsencrypt/live/appeals.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/appeals.example.com/privkey.pem;

    client_max_body_size 64m;   # allow denial-letter photo uploads

    location = / {
        return 302 /patient/;
    }

    location / {
        proxy_pass http://127.0.0.1:8781;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;   # app reads this for HSTS + client IP
        proxy_read_timeout 1800s;   # retrieval runs can take minutes
    }
}
