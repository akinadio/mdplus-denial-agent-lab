# MDplus OrthoAppeals — service environment.
# Copy to /etc/mdplus/mdplus.env, fill in, and `chmod 600` it (it holds secrets).
# Referenced by deploy/mdplus-harness.service via EnvironmentFile=.

# --- Model + search (required) ---
# Sustainable engine: an API key, not an interactive CLI login.
ANTHROPIC_API_KEY=sk-ant-...
WEB_SEARCH_API_KEY=...            # Brave Search API token
MDPLUS_API_MODEL=claude-opus-5

# --- Cost + load controls ---
MDPLUS_DAILY_BUDGET_USD=50
MDPLUS_MAX_CONCURRENT_ARMS=4
MDPLUS_PRICE_INPUT_PER_MTOK=15    # set to your model's real published prices
MDPLUS_PRICE_OUTPUT_PER_MTOK=75

# --- Abuse protection ---
MDPLUS_RATE_CREATE_PER_MIN=8
MDPLUS_RATE_LETTER_PER_MIN=12
MDPLUS_ADMIN_TOKEN=              # set to protect /evaluate /adjudicate /metrics /admin

# --- Behind the TLS reverse proxy ---
# The proxy terminates HTTPS and forwards; trust its X-Forwarded-* headers so
# HSTS is sent and the real client IP is used for rate limiting.
MDPLUS_TRUST_PROXY=true
MDPLUS_ENABLE_HSTS=true

# --- Encryption at rest (PHI) ---
# Seal uploaded denial-letter files + OCR text at rest with envelope AES-256-GCM.
# Generate once and store as a secret (do NOT commit):
#   python3 -c "from synthetic_harness import encryption; print(encryption.generate_key_b64())"
# Provide the key inline or via a file (MDPLUS_ENCRYPTION_KEY_FILE). Requires the
# 'crypto' extra: pip install -e '.[crypto]'. Losing this key makes sealed data
# unrecoverable — back it up in your secret manager.
MDPLUS_ENCRYPTION_KEY=
# MDPLUS_ENCRYPTION_KEY_FILE=/etc/mdplus/encryption.key

# --- Retention ---
# Delete episodes older than this many days (0 disables). Enforced by the
# scripts/purge_expired.py sweep (deploy/mdplus-purge.timer runs it daily).
# Match this to the retention period stated in the Privacy Notice.
MDPLUS_RETENTION_DAYS=0

# --- Backups ---
# scripts/backup.py writes here (deploy/mdplus-backup.timer runs it daily).
# Backups contain PHI — use encrypted, access-controlled storage, ideally
# off-box. Keep the newest N.
MDPLUS_BACKUP_DIR=/home/clawd/mdplus-backups
MDPLUS_BACKUP_KEEP=14

# --- State + observability ---
MDPLUS_DB_PATH=/home/clawd/mdplus-denial-agent-lab/outputs/state.sqlite3
MDPLUS_ALERT_WEBHOOK=            # optional: POST failed runs here
MDPLUS_LOG_LEVEL=INFO
