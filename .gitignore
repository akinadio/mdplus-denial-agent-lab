.DS_Store
.env
*.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

ui/node_modules/
ui/dist/
e2e/node_modules/
e2e/playwright-report/
e2e/test-results/

outputs/*
!outputs/.gitkeep
data/policy_library/*
!data/policy_library/.gitkeep
data/policy_platform/*
!data/policy_platform/source_registry.json
!data/policy_platform/source_registry.csv
!data/policy_platform/criteria_extractions.json
# Per-operation criteria, model-read and verified verbatim (build_section_criteria.py)
!data/policy_platform/section_criteria.json
# Eval benchmark: the question set and its answer key must be visible on GitHub,
# because collaborating agents clone the repo rather than this host.
!data/policy_platform/seed_review_39_spec.json
!data/policy_platform/answer_key_v1.json
# Reach OrthoAppeals policy directory + member access instructions (backup data
# that must ship in the repo, not real PHI).
!data/policy_platform/procedure_policy_links.csv
!data/policy_platform/procedure_policy_directory.json
!data/policy_platform/insurer_access_instructions.json
!data/policy_platform/README_policy_directory.md
!data/policy_platform/medicaid_coverage_by_state.csv
!data/policy_platform/medicaid_coverage_by_state.json
!data/policy_platform/insurers_by_state.json

*.passphrase
*.pem
*.key
*.log

# GoalBuddy generated board artifact (regenerable)
docs/goals/*/.goalbuddy-board/
harness_server.log

# Policy directory + verification (safe, non-PHI reference data)
!data/policy_platform/full_surgery_policy_directory.csv
!data/policy_platform/url_verification_ledger.json

!data/policy_platform/policy_registry_v2.csv
!data/policy_platform/research
!data/policy_platform/research/*
!data/policy_platform/app_option_policy_directory.csv
!data/policy_platform/research2
!data/policy_platform/research2/*

mdplus_denial_agent_lab.egg-info/
*.egg-info/
!data/policy_platform/known_citations.json

# OrthoAppeals policy data created after Aug 2026. data/policy_platform/* is
# ignored wholesale above, so every new file here needs an explicit allow or
# `git add -A` skips it silently -- which is exactly how the imaging directory
# and three sweeps of research were lost on 2026-08-30.
!data/policy_platform/app_option_policy_directory.csv
!data/policy_platform/app_option_imaging_directory.csv
!data/policy_platform/criteria_access_directory.json
!data/policy_platform/appeal_submission_routes.json
!data/policy_platform/national_submission_routes.json
!data/policy_platform/hidden_document_audit.json
!data/policy_platform/ma_plan_overrides.json
!data/policy_platform/dataqorp_leads.json
!data/policy_platform/research*/
!data/policy_platform/research*/*.json

# Study outputs ARE the evidence: every letter, every search transcript, every
# grade and score, tracked in full (2026-09-22). A reader of the paper, or an
# auditor, must be able to open the exact letter behind any number.
!study/runs/
!study/unblinding.json
!study/scores.json
!study/letter_grades.json

# Runs and keys superseded by a rebuild; kept locally for forensics only.
study/_superseded/

# Fetched policy text: the documents as they read when the quotes were
# verified. Policies change; the snapshot is what the study's checks ran on.
!data/policy_platform/policy_text_cache/
# Scratch and backups, never the repo's
COMMIT_MSG.txt
data/policy_platform/*.pre-*

study/spend.json

# Desktop app scratch, not project files
Claude outputs/

# Policies downloaded by hand (signed links a script cannot fetch); load_manual_docs.py
!data/policy_platform/manual_docs/
# one-time backups written by answer-key fixes
study/*.pre-*
docs/_superseded_*

# Manuscript drafts stay local, not in GitHub
docs/*.docx
